<!DOCTYPE html>
<html lang="zh-TW" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>InkSpire - AI 小說創作工作室</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 50: '#f5f3ff', 100: '#ede9fe', 500: '#8b5cf6', 600: '#7c3aed', 700: '#6d28d9' }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Marked.js for Preview -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(156, 163, 175, 0.4); border-radius: 3px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(156, 163, 175, 0.7); }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 h-screen flex flex-col overflow-hidden transition-colors duration-200">

    <!-- 頂部導覽列 -->
    <header class="h-14 border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex items-center justify-between px-4 shrink-0 z-20">
        <div class="flex items-center space-x-3">
            <button id="bookshelf-btn" class="flex items-center space-x-2 px-3 py-1.5 rounded-lg bg-brand-50 dark:bg-brand-900/40 text-brand-600 dark:text-brand-300 font-medium hover:bg-brand-100 dark:hover:bg-brand-900/60 transition text-sm">
                <i class="fa-solid fa-books"></i>
                <span id="current-book-title">載入中...</span>
                <i class="fa-solid fa-chevron-down text-xs ml-1"></i>
            </button>
            <div class="h-4 w-px bg-slate-300 dark:bg-slate-700"></div>
            <div class="flex items-center space-x-2 text-sm text-slate-500 dark:text-slate-400">
                <span id="header-chapter-info">請選擇章節</span>
            </div>
        </div>

        <div class="flex items-center space-x-3">
            <!-- 專注模式按鈕 -->
            <button id="focus-mode-btn" title="專注模式 (隱藏側邊欄)" class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                <i class="fa-solid fa-expand"></i>
            </button>
            <!-- 主題切換 -->
            <button id="theme-toggle" title="切換深色/淺色模式" class="p-2 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                <i class="fa-solid fa-moon dark:hidden"></i>
                <i class="fa-solid fa-sun hidden dark:inline"></i>
            </button>
            <!-- 設定 API Key 按鈕 -->
            <button id="open-settings-btn" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition text-sm">
                <i class="fa-solid fa-key text-amber-500"></i>
                <span>API 設定</span>
            </button>
        </div>
    </header>

    <!-- 主體區域 -->
    <div class="flex-1 flex overflow-hidden relative">

        <!-- 左側面板：作品結構 -->
        <aside id="left-sidebar" class="w-72 border-r border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col shrink-0 transition-all duration-300 z-10">
            <!-- 側邊欄 Tab 切換 -->
            <div class="flex border-b border-slate-200 dark:border-slate-800 text-xs font-medium">
                <button onclick="switchTab('chapters')" id="tab-btn-chapters" class="flex-1 py-3 text-center border-b-2 border-brand-500 text-brand-600 dark:text-brand-400 bg-brand-50/50 dark:bg-brand-950/20">章節大綱</button>
                <button onclick="switchTab('world')" id="tab-btn-world" class="flex-1 py-3 text-center border-b-2 border-transparent text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">人物世界觀</button>
                <button onclick="switchTab('plot')" id="tab-btn-plot" class="flex-1 py-3 text-center border-b-2 border-transparent text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">伏筆主線</button>
            </div>

            <!-- Tab 1: 章節列表 -->
            <div id="tab-content-chapters" class="flex-1 flex flex-col overflow-hidden">
                <div class="p-3 border-b border-slate-100 dark:border-slate-800/60 flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">章節列表</span>
                    <button onclick="addChapter()" class="text-xs px-2 py-1 bg-brand-500 text-white rounded hover:bg-brand-600 transition flex items-center space-x-1">
                        <i class="fa-solid fa-plus"></i><span>新增章節</span>
                    </button>
                </div>
                <div id="chapter-list" class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-1">
                    <!-- 動態渲染 -->
                </div>
            </div>

            <!-- Tab 2: 人物與世界觀 -->
            <div id="tab-content-world" class="flex-1 hidden flex-col overflow-hidden">
                <div class="p-3 border-b border-slate-100 dark:border-slate-800/60 flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">人物與設定</span>
                    <button onclick="addWorldItem()" class="text-xs px-2 py-1 bg-brand-500 text-white rounded hover:bg-brand-600 transition flex items-center space-x-1">
                        <i class="fa-solid fa-plus"></i><span>新增項目</span>
                    </button>
                </div>
                <div id="world-list" class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-2">
                    <!-- 動態渲染 -->
                </div>
            </div>

            <!-- Tab 3: 伏筆與時間線 -->
            <div id="tab-content-plot" class="flex-1 hidden flex-col overflow-hidden">
                <div class="p-3 border-b border-slate-100 dark:border-slate-800/60 flex items-center justify-between">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">伏筆與主線追蹤</span>
                    <button onclick="addPlotItem()" class="text-xs px-2 py-1 bg-brand-500 text-white rounded hover:bg-brand-600 transition flex items-center space-x-1">
                        <i class="fa-solid fa-plus"></i><span>新增伏筆</span>
                    </button>
                </div>
                <div id="plot-list" class="flex-1 overflow-y-auto custom-scrollbar p-2 space-y-2">
                    <!-- 動態渲染 -->
                </div>
            </div>
        </aside>

        <!-- 中央：寫作主區域 -->
        <main class="flex-1 flex flex-col bg-slate-100 dark:bg-slate-950 overflow-hidden relative">
            <!-- 寫作工具列 -->
            <div class="h-12 border-b border-slate-200 dark:border-slate-800 bg-white/50 dark:bg-slate-900/50 backdrop-blur px-4 flex items-center justify-between shrink-0">
                <div class="flex items-center space-x-3">
                    <input type="text" id="chapter-title-input" placeholder="請輸入章節標題..." class="bg-transparent font-bold text-slate-800 dark:text-slate-100 focus:outline-none border-b border-transparent focus:border-brand-500 px-1 py-0.5 text-lg w-72">
                </div>
                <div class="flex items-center space-x-4 text-xs text-slate-500 dark:text-slate-400 font-medium">
                    <div>本章字數: <span id="word-count-chapter" class="font-bold text-slate-700 dark:text-slate-200">0</span> 字</div>
                    <div>總字數: <span id="word-count-total" class="font-bold text-slate-700 dark:text-slate-200">0</span> 字</div>
                    <div class="flex bg-slate-200 dark:bg-slate-800 rounded-lg p-0.5">
                        <button onclick="setEditorMode('edit')" id="mode-edit-btn" class="px-2.5 py-1 rounded-md bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-sm transition">編輯</button>
                        <button onclick="setEditorMode('preview')" id="mode-preview-btn" class="px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 transition">預覽</button>
                    </div>
                </div>
            </div>

            <!-- 編輯與預覽容器 -->
            <div class="flex-1 relative overflow-hidden flex">
                <textarea id="editor-textarea" class="w-full h-full p-6 md:p-10 bg-transparent resize-none focus:outline-none text-base md:text-lg leading-relaxed custom-scrollbar font-serif" placeholder="在此開始您的故事創作... (支援 Markdown 語法)"></textarea>
                <div id="editor-preview" class="hidden w-full h-full p-6 md:p-10 overflow-y-auto custom-scrollbar prose dark:prose-invert max-w-none font-serif"></div>
            </div>
        </main>

        <!-- 右側面板：Gemini AI 助理 -->
        <aside id="right-sidebar" class="w-80 border-l border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 flex flex-col shrink-0 transition-all duration-300 z-10">
            <div class="p-3 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between bg-brand-50/50 dark:bg-brand-950/20">
                <div class="flex items-center space-x-2 text-brand-600 dark:text-brand-400 font-bold text-sm">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    <span>Gemini AI 寫作助手</span>
                </div>
                <span class="text-xs px-2 py-0.5 bg-brand-100 dark:bg-brand-900/60 text-brand-700 dark:text-brand-300 rounded-full font-medium">3.8 Flash</span>
            </div>

            <!-- 11大 AI 快捷按鈕面板 -->
            <div class="p-3 border-b border-slate-100 dark:border-slate-800/60 grid grid-cols-2 gap-1.5 max-h-56 overflow-y-auto custom-scrollbar">
                <button onclick="runAiAction('continue')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-angles-right text-brand-500"></i><span>1. 接著寫</span>
                </button>
                <button onclick="runAiAction('stuck')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-life-ring text-brand-500"></i><span>2. 我卡住了</span>
                </button>
                <button onclick="runAiAction('inspire')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-lightbulb text-brand-500"></i><span>3. 給我靈感</span>
                </button>
                <button onclick="runAiAction('next_scene')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-film text-brand-500"></i><span>4. 下一幕劇情</span>
                </button>
                <button onclick="runAiAction('foreshadow')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-seedling text-brand-500"></i><span>5. 埋設伏筆</span>
                </button>
                <button onclick="runAiAction('reaction')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-masks-theater text-brand-500"></i><span>6. 角色反應</span>
                </button>
                <button onclick="runAiAction('logic_check')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-stethoscope text-brand-500"></i><span>7. 檢查邏輯</span>
                </button>
                <button onclick="runAiAction('consistency')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-book-bookmark text-brand-500"></i><span>8. 設一致性</span>
                </button>
                <button onclick="runAiAction('imagery')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-palette text-brand-500"></i><span>9. 增加畫面感</span>
                </button>
                <button onclick="runAiAction('dialogue')" class="ai-btn px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-comments text-brand-500"></i><span>10. 優化對話</span>
                </button>
                <button onclick="runAiAction('concise')" class="ai-btn col-span-2 px-2.5 py-1.5 text-xs bg-slate-100 dark:bg-slate-800 hover:bg-brand-50 dark:hover:bg-brand-950/50 hover:text-brand-600 rounded-md text-left transition flex items-center space-x-1.5">
                    <i class="fa-solid fa-compress text-brand-500"></i><span>11. 潤飾精簡文字</span>
                </button>
            </div>

            <!-- AI 對話回覆與輸出區 -->
            <div id="ai-chat-container" class="flex-1 overflow-y-auto custom-scrollbar p-3 space-y-3 text-xs leading-relaxed">
                <div class="bg-slate-100 dark:bg-slate-800/80 p-3 rounded-lg text-slate-600 dark:text-slate-300">
                    你好！我是你的專屬 AI 小說協作夥伴。點擊上方 11 大功能按鈕，或在下方輸入自訂指令，我隨時為你提供靈感與續寫支援！
                </div>
            </div>

            <!-- AI 輸入區 -->
            <div class="p-3 border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900">
                <div class="flex items-center space-x-2">
                    <input type="text" id="ai-prompt-input" placeholder="對 AI 說點什麼或下達指令..." class="flex-1 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-brand-500">
                    <button onclick="sendCustomAiPrompt()" class="bg-brand-500 text-white px-3 py-2 rounded-lg hover:bg-brand-600 transition text-xs">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </div>
            </div>
        </aside>
    </div>

    <!-- 書架管理 Modal -->
    <div id="bookshelf-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-2xl max-h-[80vh] flex flex-col shadow-2xl overflow-hidden">
            <div class="p-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <h3 class="font-bold text-base flex items-center space-x-2">
                    <i class="fa-solid fa-books text-brand-500"></i>
                    <span>我的書架 (多作品管理)</span>
                </h3>
                <button onclick="closeBookshelfModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <div class="p-4 flex-1 overflow-y-auto custom-scrollbar space-y-3" id="bookshelf-cards-container">
                <!-- 動態書籍列表 -->
            </div>
            <div class="p-4 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center bg-slate-50 dark:bg-slate-900/50">
                <button onclick="createNewBook()" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-medium transition flex items-center space-x-2">
                    <i class="fa-solid fa-plus"></i><span>建立新小說</span>
                </button>
                <button onclick="closeBookshelfModal()" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-medium transition">關閉書架</button>
            </div>
        </div>
    </div>

    <!-- API 設定 Modal -->
    <div id="settings-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="font-bold text-base flex items-center space-x-2">
                    <i class="fa-solid fa-key text-amber-500"></i>
                    <span>Gemini API 金鑰設定</span>
                </h3>
                <button onclick="closeSettingsModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                請輸入您的 Google Gemini API Key。金鑰將安全地儲存在您瀏覽器的 LocalStorage 中，絕不會外洩。
            </p>
            <div>
                <label class="block text-xs font-medium text-slate-600 dark:text-slate-300 mb-1">API Key</label>
                <input type="password" id="api-key-input" placeholder="AIzaSy..." class="w-full bg-slate-100 dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-xl px-3 py-2 text-sm focus:outline-none focus:border-brand-500">
            </div>
            <div class="flex justify-end space-x-2 pt-2">
                <button onclick="closeSettingsModal()" class="px-4 py-2 bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-medium transition">取消</button>
                <button onclick="saveApiKey()" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white rounded-xl text-xs font-medium transition">儲存金鑰</button>
            </div>
        </div>
    </div>

    <!-- 核心 JS 邏輯 -->
    <script>
        // 資料結構與狀態管理
        let appData = JSON.parse(localStorage.getItem('inkspire_app_data')) || {
            currentBookId: 'book_1',
            books: [
                {
                    id: 'book_1',
                    title: '未命名小說',
                    summary: '這是一部精彩的小說創作作品。',
                    chapters: [
                        { id: 'ch_1', title: '第一章：起初', content: '故事在這裡展開...' }
                    ],
                    world: [
                        { id: 'w_1', title: '主角：主角名字', content: '性格冷靜，身懷祕密。' }
                    ],
                    plots: [
                        { id: 'p_1', title: '神祕失蹤案伏筆', content: '第一章留下的信物線索。' }
                    ]
                }
            ]
        };

        let currentChapterId = null;
        let editorMode = 'edit';
        let activeTab = 'chapters';

        // 初始化
        function initApp() {
            // 主題初始化
            const savedTheme = localStorage.getItem('inkspire_theme') || 'dark';
            if (savedTheme === 'light') {
                document.documentElement.classList.remove('dark');
            } else {
                document.documentElement.classList.add('dark');
            }

            // 確保有選中的書本與章節
            let currentBook = appData.books.find(b => b.id === appData.currentBookId);
            if (!currentBook && appData.books.length > 0) {
                appData.currentBookId = appData.books[0].id;
                currentBook = appData.books[0];
            }

            if (currentBook && currentBook.chapters.length > 0) {
                currentChapterId = currentBook.chapters[0].id;
            }

            renderAll();
            setupEventListeners();
        }

        function saveAppData() {
            localStorage.setItem('inkspire_app_data', JSON.stringify(appData));
        }

        function getCurrentBook() {
            return appData.books.find(b => b.id === appData.currentBookId) || appData.books[0];
        }

        function getCurrentChapter() {
            const book = getCurrentBook();
            return book.chapters.find(c => c.id === currentChapterId) || book.chapters[0];
        }

        // 渲染全部介面
        function renderAll() {
            const book = getCurrentBook();
            const chapter = getCurrentChapter();

            document.getElementById('current-book-title').textContent = book.title;

            // 渲染章節清單
            const chapListEl = document.getElementById('chapter-list');
            chapListEl.innerHTML = '';
            book.chapters.forEach((ch, idx) => {
                const isSelected = ch.id === currentChapterId;
                const div = document.createElement('div');
                div.className = `p-2.5 rounded-lg text-xs cursor-pointer flex items-center justify-between group transition ${isSelected ? 'bg-brand-500 text-white font-medium shadow-sm' : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800'}`;
                div.innerHTML = `
                    <div class="truncate flex-1" onclick="selectChapter('${ch.id}')">
                        <span class="opacity-70 mr-1.5">${idx + 1}.</span> ${ch.title || '未命名章節'}
                    </div>
                    <button onclick="deleteChapter(event, '${ch.id}')" class="opacity-0 group-hover:opacity-100 p-1 hover:text-red-400 transition"><i class="fa-solid fa-trash-can"></i></button>
                `;
                chapListEl.appendChild(div);
            });

            // 渲染世界觀清單
            const worldListEl = document.getElementById('world-list');
            worldListEl.innerHTML = '';
            book.world.forEach((item) => {
                const div = document.createElement('div');
                div.className = 'p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1';
                div.innerHTML = `
                    <div class="flex justify-between items-center">
                        <input type="text" value="${item.title}" onchange="updateWorldItem('${item.id}', 'title', this.value)" class="bg-transparent font-bold text-xs focus:outline-none w-full">
                        <button onclick="deleteWorldItem('${item.id}')" class="text-slate-400 hover:text-red-500 text-xs ml-2"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                    <textarea onchange="updateWorldItem('${item.id}', 'content', this.value)" class="w-full bg-transparent text-xs text-slate-500 dark:text-slate-400 resize-none focus:outline-none custom-scrollbar" rows="2">${item.content}</textarea>
                `;
                worldListEl.appendChild(div);
            });

            // 渲染伏筆清單
            const plotListEl = document.getElementById('plot-list');
            plotListEl.innerHTML = '';
            book.plots.forEach((item) => {
                const div = document.createElement('div');
                div.className = 'p-2.5 rounded-lg bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-800 space-y-1';
                div.innerHTML = `
                    <div class="flex justify-between items-center">
                        <input type="text" value="${item.title}" onchange="updatePlotItem('${item.id}', 'title', this.value)" class="bg-transparent font-bold text-xs focus:outline-none w-full">
                        <button onclick="deletePlotItem('${item.id}')" class="text-slate-400 hover:text-red-500 text-xs ml-2"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                    <textarea onchange="updatePlotItem('${item.id}', 'content', this.value)" class="w-full bg-transparent text-xs text-slate-500 dark:text-slate-400 resize-none focus:outline-none custom-scrollbar" rows="2">${item.content}</textarea>
                `;
                plotListEl.appendChild(div);
            });

            // 渲染當前章節內容到編輯器
            if (chapter) {
                document.getElementById('chapter-title-input').value = chapter.title;
                document.getElementById('editor-textarea').value = chapter.content || '';
                document.getElementById('header-chapter-info').textContent = `${book.title} > ${chapter.title}`;
                updateWordCounts();
            }
        }

        // 事件監聽與互動
        function setupEventListeners() {
            const textarea = document.getElementById('editor-textarea');
            textarea.addEventListener('input', (e) => {
                const chapter = getCurrentChapter();
                if (chapter) {
                    chapter.content = e.target.value;
                    saveAppData();
                    updateWordCounts();
                }
            });

            const titleInput = document.getElementById('chapter-title-input');
            titleInput.addEventListener('input', (e) => {
                const chapter = getCurrentChapter();
                if (chapter) {
                    chapter.title = e.target.value;
                    saveAppData();
                    renderAll();
                }
            });

            // 主題切換按鈕綁定
            document.getElementById('theme-toggle').addEventListener('click', () => {
                const isDark = document.documentElement.classList.toggle('dark');
                localStorage.setItem('inkspire_theme', isDark ? 'dark' : 'light');
            });

            // 專注模式按鈕
            document.getElementById('focus-mode-btn').addEventListener('click', () => {
                const leftSidebar = document.getElementById('left-sidebar');
                const rightSidebar = document.getElementById('right-sidebar');
                leftSidebar.classList.toggle('hidden');
                rightSidebar.classList.toggle('hidden');
            });

            // 書架 Modal 按鈕
            document.getElementById('bookshelf-btn').addEventListener('click', openBookshelfModal);
            document.getElementById('open-settings-btn').addEventListener('click', openSettingsModal);
        }

        function updateWordCounts() {
            const chapter = getCurrentChapter();
            const text = chapter ? chapter.content || '' : '';
            const chapterCount = text.replace(/\s+/g, '').length;
            document.getElementById('word-count-chapter').textContent = chapterCount;

            const book = getCurrentBook();
            let totalCount = 0;
            book.chapters.forEach(ch => {
                totalCount += (ch.content || '').replace(/\s+/g, '').length;
            });
            document.getElementById('word-count-total').textContent = totalCount;
        }

        function switchTab(tabName) {
            activeTab = tabName;
            ['chapters', 'world', 'plot'].forEach(t => {
                const btn = document.getElementById(`tab-btn-${t}`);
                const content = document.getElementById(`tab-content-${t}`);
                if (t === tabName) {
                    btn.className = 'flex-1 py-3 text-center border-b-2 border-brand-500 text-brand-600 dark:text-brand-400 bg-brand-50/50 dark:bg-brand-950/20 font-medium';
                    content.classList.remove('hidden');
                } else {
                    btn.className = 'flex-1 py-3 text-center border-b-2 border-transparent text-slate-500 hover:text-slate-700 dark:hover:text-slate-300';
                    content.classList.add('hidden');
                }
            });
        }

        function setEditorMode(mode) {
            editorMode = mode;
            const textarea = document.getElementById('editor-textarea');
            const preview = document.getElementById('editor-preview');
            const editBtn = document.getElementById('mode-edit-btn');
            const previewBtn = document.getElementById('mode-preview-btn');

            if (mode === 'edit') {
                textarea.classList.remove('hidden');
                preview.classList.add('hidden');
                editBtn.className = 'px-2.5 py-1 rounded-md bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-sm transition';
                previewBtn.className = 'px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 transition';
            } else {
                textarea.classList.add('hidden');
                preview.classList.remove('hidden');
                preview.innerHTML = marked.parse(textarea.value);
                previewBtn.className = 'px-2.5 py-1 rounded-md bg-white dark:bg-slate-700 text-slate-800 dark:text-white shadow-sm transition';
                editBtn.className = 'px-2.5 py-1 rounded-md text-slate-600 dark:text-slate-400 transition';
            }
        }

        function selectChapter(id) {
            currentChapterId = id;
            renderAll();
        }

        function addChapter() {
            const book = getCurrentBook();
            const newId = 'ch_' + Date.now();
            book.chapters.push({
                id: newId,
                title: `第 ${book.chapters.length + 1} 章`,
                content: ''
            });
            currentChapterId = newId;
            saveAppData();
            renderAll();
        }

        function deleteChapter(e, id) {
            e.stopPropagation();
            const book = getCurrentBook();
            if (book.chapters.length <= 1) {
                alert('每本書至少需要保留一個章節！');
                return;
            }
            book.chapters = book.chapters.filter(c => c.id !== id);
            if (currentChapterId === id) {
                currentChapterId = book.chapters[0].id;
            }
            saveAppData();
            renderAll();
        }

        function addWorldItem() {
            const book = getCurrentBook();
            book.world.push({ id: 'w_' + Date.now(), title: '新設定項目', content: '設定內容...' });
            saveAppData();
            renderAll();
        }

        function updateWorldItem(id, field, val) {
            const book = getCurrentBook();
            const item = book.world.find(w => w.id === id);
            if (item) {
                item[field] = val;
                saveAppData();
            }
        }

        function deleteWorldItem(id) {
            const book = getCurrentBook();
            book.world = book.world.filter(w => w.id !== id);
            saveAppData();
            renderAll();
        }

        function addPlotItem() {
            const book = getCurrentBook();
            book.plots.push({ id: 'p_' + Date.now(), title: '新伏筆主線', content: '伏筆描述...' });
            saveAppData();
            renderAll();
        }

        function updatePlotItem(id, field, val) {
            const book = getCurrentBook();
            const item = book.plots.find(p => p.id === id);
            if (item) {
                item[field] = val;
                saveAppData();
            }
        }

        function deletePlotItem(id) {
            const book = getCurrentBook();
            book.plots = book.plots.filter(p => p.id !== id);
            saveAppData();
            renderAll();
        }

        // 書架 Modal 相關
        function openBookshelfModal() {
            const container = document.getElementById('bookshelf-cards-container');
            container.innerHTML = '';
            appData.books.forEach(book => {
                let totalWords = 0;
                book.chapters.forEach(ch => totalWords += (ch.content || '').replace(/\s+/g, '').length);

                const card = document.createElement('div');
                card.className = `p-4 rounded-xl border transition flex items-center justify-between ${book.id === appData.currentBookId ? 'border-brand-500 bg-brand-50/30 dark:bg-brand-950/20' : 'border-slate-200 dark:border-slate-800 hover:border-slate-300 dark:hover:border-slate-700'}`;
                card.innerHTML = `
                    <div class="space-y-1 flex-1">
                        <input type="text" value="${book.title}" onchange="updateBookTitle('${book.id}', this.value)" class="font-bold bg-transparent text-sm focus:outline-none border-b border-transparent focus:border-brand-500">
                        <textarea onchange="updateBookSummary('${book.id}', this.value)" class="w-full text-xs text-slate-500 dark:text-slate-400 bg-transparent resize-none focus:outline-none custom-scrollbar" rows="1">${book.summary}</textarea>
                        <div class="text-[10px] text-slate-400">總字數: ${totalWords} 字 | 章節數: ${book.chapters.length} 章</div>
                    </div>
                    <div class="flex items-center space-x-2 ml-4">
                        <button onclick="switchBook('${book.id}')" class="px-3 py-1.5 bg-brand-500 text-white rounded-lg text-xs hover:bg-brand-600 transition">進入寫作</button>
                        <button onclick="deleteBook('${book.id}')" class="p-2 text-slate-400 hover:text-red-500 transition text-xs"><i class="fa-solid fa-trash-can"></i></button>
                    </div>
                `;
                container.appendChild(card);
            });
            document.getElementById('bookshelf-modal').classList.remove('hidden');
        }

        function closeBookshelfModal() {
            document.getElementById('bookshelf-modal').classList.add('hidden');
        }

        function createNewBook() {
            const newId = 'book_' + Date.now();
            appData.books.push({
                id: newId,
                title: '新小說作品',
                summary: '請輸入作品簡介...',
                chapters: [{ id: 'ch_' + Date.now(), title: '第一章', content: '' }],
                world: [{ id: 'w_' + Date.now(), title: '主角設定', content: '在此輸入主角特徵...' }],
                plots: [{ id: 'p_' + Date.now(), title: '主要核心主線', content: '在此輸入主線走向...' }]
            });
            saveAppData();
            openBookshelfModal();
        }

        function updateBookTitle(id, val) {
            const book = appData.books.find(b => b.id === id);
            if (book) {
                book.title = val;
                saveAppData();
                document.getElementById('current-book-title').textContent = val;
            }
        }

        function updateBookSummary(id, val) {
            const book = appData.books.find(b => b.id === id);
            if (book) {
                book.summary = val;
                saveAppData();
            }
        }

        function switchBook(id) {
            appData.currentBookId = id;
            const book = getCurrentBook();
            if (book && book.chapters.length > 0) {
                currentChapterId = book.chapters[0].id;
            }
            saveAppData();
            closeBookshelfModal();
            renderAll();
        }

        function deleteBook(id) {
            if (appData.books.length <= 1) {
                alert('至少需要保留一部小說作品！');
                return;
            }
            if (confirm('確定要刪除這部小說嗎？此動作無法復原。')) {
                appData.books = appData.books.filter(b => b.id !== id);
                if (appData.currentBookId === id) {
                    appData.currentBookId = appData.books[0].id;
                    currentChapterId = appData.books[0].chapters[0].id;
                }
                saveAppData();
                openBookshelfModal();
                renderAll();
            }
        }

        // API Key 設定 Modal
        function openSettingsModal() {
            const key = localStorage.getItem('inkspire_gemini_api_key') || '';
            document.getElementById('api-key-input').value = key;
            document.getElementById('settings-modal').classList.remove('hidden');
        }

        function closeSettingsModal() {
            document.getElementById('settings-modal').classList.add('hidden');
        }

        function saveApiKey() {
            const key = document.getElementById('api-key-input').value.trim();
            if (key) {
                localStorage.setItem('inkspire_gemini_api_key', key);
                alert('API Key 儲存成功！');
                closeSettingsModal();
            } else {
                alert('請輸入有效的 API Key');
            }
        }

        // Gemini AI 整合功能 (使用 gemini-3.8-flash)
        async function runAiAction(actionType) {
            const apiKey = localStorage.getItem('inkspire_gemini_api_key');
            if (!apiKey) {
                alert('請先點擊右上角「API 設定」輸入您的 Gemini API Key！');
                openSettingsModal();
                return;
            }

            const chapter = getCurrentChapter();
            const book = getCurrentBook();
            const currentText = chapter ? chapter.content || '' : '';

            let promptInstruction = '';
            switch(actionType) {
                case 'continue': promptInstruction = '請根據以下小說內容接續寫下去，保持文風一致，情節流暢，字數約 300-500 字：\n\n' + currentText; break;
                case 'stuck': promptInstruction = '作者目前卡文了。請根據現有情節給出 3 種不同的後續發展方向建議：\n\n' + currentText; break;
                case 'inspire': promptInstruction = '請為這部小說《' + book.title + '》提供一段精彩的劇情靈感或衝突轉折：'; break;
                case 'next_scene': promptInstruction = '請規劃並撰寫接下來的一個場景，推動劇情發展：\n\n' + currentText; break;
                case 'foreshadow': promptInstruction = '請在現有內容中巧妙地埋下一個神祕的伏筆或線索：\n\n' + currentText; break;
                case 'reaction': promptInstruction = '請描繪書中角色面對目前處境時的心理活動與細膩表情反應：\n\n' + currentText; break;
                case 'logic_check': promptInstruction = '請幫忙檢查以下內容是否有邏輯漏洞或Bug，並給出修改建議：\n\n' + currentText; break;
                case 'consistency': promptInstruction = '請檢查情節與世界觀設定是否一致，給出修飾意見：\n\n' + currentText; break;
                case 'imagery': promptInstruction = '請增強以下內容的環境與感官描繪（畫面感、光影、氣味），讓文字更有沉浸感：\n\n' + currentText; break;
                case 'dialogue': promptInstruction = '請優化以下內容中的對話，使其更有張力、符合角色性格：\n\n' + currentText; break;
                case 'concise': promptInstruction = '請精簡與潤飾以下文字，去除贅字，使節奏更明快流暢：\n\n' + currentText; break;
            }

            await callGeminiApi(promptInstruction, true);
        }

        async function sendCustomAiPrompt() {
            const inputEl = document.getElementById('ai-prompt-input');
            const text = inputEl.value.trim();
            if (!text) return;

            const apiKey = localStorage.getItem('inkspire_gemini_api_key');
            if (!apiKey) {
                alert('請先設定 Gemini API Key！');
                openSettingsModal();
                return;
            }

            inputEl.value = '';
            const chapter = getCurrentChapter();
            const currentText = chapter ? chapter.content || '' : '';
            const fullPrompt = `${text}\n\n【目前章節內容參考】:\n${currentText}`;
            await callGeminiApi(fullPrompt, false);
        }

        async function callGeminiApi(promptText, isInsertable) {
            const apiKey = localStorage.getItem('inkspire_gemini_api_key');
            const chatContainer = document.getElementById('ai-chat-container');

            // 顯示載入中訊息
            const loadingId = 'loading_' + Date.now();
            const loadingDiv = document.createElement('div');
            loadingDiv.id = loadingId;
            loadingDiv.className = 'bg-slate-100 dark:bg-slate-800 p-3 rounded-lg text-slate-500 animate-pulse';
            loadingDiv.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-2"></i>AI 正在思考中...';
            chatContainer.appendChild(loadingDiv);
            chatContainer.scrollTop = chatContainer.scrollHeight;

            try {
                // 使用最新指定的 gemini-3.8-flash 模型端點
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: promptText }] }]
                    })
                });

                const data = await response.json();
                document.getElementById(loadingId).remove();

                if (data.candidates && data.candidates[0].content.parts[0].text) {
                    const aiReply = data.candidates[0].content.parts[0].text;
                    
                    const replyDiv = document.createElement('div');
                    replyDiv.className = 'bg-brand-50 dark:bg-brand-950/30 border border-brand-200 dark:border-brand-900/50 p-3 rounded-lg space-y-2 text-slate-700 dark:text-slate-200';
                    
                    let htmlContent = `<div class="font-bold text-brand-600 dark:text-brand-400 mb-1">Gemini AI 回覆：</div><div>${marked.parse(aiReply)}</div>`;
                    
                    if (isInsertable) {
                        const btnId = 'insert_btn_' + Date.now();
                        htmlContent += `<button id="${btnId}" class="mt-2 px-2.5 py-1 bg-brand-500 hover:bg-brand-600 text-white rounded text-[11px] transition flex items-center space-x-1">
                            <i class="fa-solid fa-plus"></i><span>插入到文章結尾</span>
                        </button>`;
                        replyDiv.innerHTML = htmlContent;
                        chatContainer.appendChild(replyDiv);
                        chatContainer.scrollTop = chatContainer.scrollHeight;

                        document.getElementById(btnId).addEventListener('click', () => {
                            const textarea = document.getElementById('editor-textarea');
                            textarea.value += '\n\n' + aiReply;
                            const chapter = getCurrentChapter();
                            if (chapter) {
                                chapter.content = textarea.value;
                                saveAppData();
                                updateWordCounts();
                            }
                            alert('已成功插入文章結尾！');
                        });
                    } else {
                        replyDiv.innerHTML = htmlContent;
                        chatContainer.appendChild(replyDiv);
                        chatContainer.scrollTop = chatContainer.scrollHeight;
                    }

                } else {
                    throw new Error(data.error ? data.error.message : '未知錯誤');
                }

            } catch (error) {
                if (document.getElementById(loadingId)) {
                    document.getElementById(loadingId).remove();
                }
                const errDiv = document.createElement('div');
                errDiv.className = 'bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900/50 p-3 rounded-lg text-red-600 dark:text-red-400';
                errDiv.textContent = `連線發生錯誤: ${error.message}。請確認 API Key 是否正確。`;
                chatContainer.appendChild(errDiv);
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        }

        // 啟動應用
        window.onload = initApp;
    </script>
</body>
</html>
